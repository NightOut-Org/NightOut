{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git -C * commit:*)",
      "Bash(git -C * push:*)",
      "Bash(git -C * merge:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git -C * commit:*)",
      "PowerShell(git -C * push:*)",
      "PowerShell(git -C * merge:*)",
      "PowerShell(gh pr merge:*)",
      "mcp__ccd_host__sync_with_base_branch",
      "mcp__ccd_pr__set_auto_merge"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"console.log('NightOut: ก่อนเริ่มงานแรกของ session ให้รัน skill sync-requirements เอง (เทียบ revisionId ของ Google Doc Nightout_2.day กับ docs/requirements/nightout-2-day.md) แล้วอ่าน docs/REQUIREMENTS.md — ไม่ต้องรอผู้ใช้สั่ง')\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "system-design-skills@anthropic-plugin-directory": true
  }
}
