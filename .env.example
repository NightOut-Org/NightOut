# ---- Frontend (apps/frontend, apps/admin) — Vite ต้องขึ้นต้นด้วย VITE_ · VITE_API_URL เดิมยังอ่านเป็นค่าสำรอง ----
# Supabase ในหน้าเว็บใช้เฉพาะ Auth (เข้าสู่ระบบ) — anon key เป็น publishable key · ห้ามใส่ service_role ใน VITE_* (ADR 0002)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# NestJS API — หน้าเว็บอ่าน/เขียนข้อมูลผ่านตัวนี้เท่านั้น (ว่าง: dev = http://localhost:3000/api, deploy = /api)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_TURNSTILE_SITE_KEY=
# แผนที่: ว่าง = OpenFreeMap vector · โหลดล้มเหลวใช้ OpenStreetMap raster สำรอง
# URL raster ที่กำหนดเองต้องใช้ public key ที่จำกัด domain เท่านั้น
VITE_MAP_TILE_URL_LIGHT=
VITE_MAP_TILE_URL_DARK=
VITE_MAP_TILE_ATTRIBUTION=
# เวลารอ vector ก่อนใช้ raster สำรอง (milliseconds)
VITE_MAP_LOAD_TIMEOUT_MS=15000

# ---- Backend (backend/api) ----
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# ใช้อ่านข้อมูลแทนหน้าเว็บโดยให้ RLS ทำงานตามสิทธิ์ผู้เรียก (ค่าเดียวกับ VITE_SUPABASE_ANON_KEY · ว่าง = ใช้ค่านั้น)
SUPABASE_ANON_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
JOB_SECRET=change-me
# dev: ให้ backend รัน job หมดเวลาการจองเองทุกกี่ ms (0 = ปิด · DB จริงมี pg_cron แล้ว — เปิดเฉพาะ DB ในเครื่อง เช่น 60000)
JOBS_LOCAL_INTERVAL_MS=0
QR_SIGNING_KEY=change-me
# เข้ารหัสเลขบัญชีร้าน (AES-256-GCM) — สุ่มยาว ≥ 16 ตัว, ห้ามเปลี่ยนหลังมีข้อมูลแล้ว
PAYOUT_ENCRYPTION_KEY=change-me-at-least-16-chars
# ค้นหาที่อยู่/ปักหมุดร้าน (GET /geocode/*) — backend เรียก OpenStreetMap Nominatim แทนหน้าเว็บ (เฉพาะไทย · ไม่ต้องมี key)
# instance สาธารณะ: ไม่เกิน 1 ครั้ง/วินาที + ระบุ User-Agent ตามนโยบาย · traffic เยอะ = เปลี่ยน GEOCODER_URL เป็น self-host / เจ้าที่เสียเงิน
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=NightOut/1.0 (+https://nightout.day)
# GEOCODER_EMAIL=ops@example.com
# GEOCODER_MIN_INTERVAL_MS=1100
# ---- ชำระเงินออนไลน์ (domains/payment) ----
# ว่าง = โอน PromptPay + แนบสลิปเดิม · mock = หน้าชำระเงินจำลอง (ทดสอบ ไม่ตัดเงินจริง) · beam = โครงรอเชื่อม (ยังไม่พร้อม → ใช้สลิปต่อ)
PAYMENT_PROVIDER=
# ลับตรวจลายเซ็น webhook (≥ 16 ตัว · ว่าง = ค่า dev ของ mock ใช้ได้เฉพาะเครื่อง dev)
PAYMENT_WEBHOOK_SECRET=
# เปิด mock บน deploy (เดโมเท่านั้น) — ต้องตั้ง PAYMENT_WEBHOOK_SECRET ด้วย
PAYMENT_ALLOW_MOCK_IN_PRODUCTION=false
# origin ของเว็บลูกค้า (ลิงก์กลับหลังชำระ) เช่น https://nightout.day
WEB_APP_URL=
LINE_CHANNEL_ACCESS_TOKEN=
